{
  "name": "github-markdown-pdf",
  "version": "0.1.0",
  "description": "Convert GitHub-flavoured Markdown to polished PDF files",
  "bin": {
    "github-markdown-pdf": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skill"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives",
    "pretest": "pnpm build",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "concurrently --kill-others-on-fail --names typecheck,lint,format --prefix-colors blue,magenta,green \"pnpm typecheck\" \"pnpm lint\" \"pnpm format:check\"",
    "md-to-pdf": "tsx src/cli.ts",
    "install:global": "tsx scripts/install-global.ts",
    "skill:install": "tsx scripts/install-skill.ts",
    "setup:global": "tsx scripts/setup-global.ts"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "jsdom": "^30.1.3",
    "marked": "^18.1.2",
    "pele": "^1.12.0",
    "playwright": "^1.64.1",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "26.6.5",
    "concurrently": "^10.0.6",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsdown": "0.23.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=12.16.1 <13"
  },
  "packageManager": "pnpm@12.16.1"
}
